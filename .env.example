# The same Postgres the moonshot service uses (it creates and migrates every table; this app only reads and writes them).
# On Railway: DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL=

# Admin sign-in is the admin key only. 12+ random characters.
ADMIN_KEY=
# Secret address of the admin key form: ADMIN_ENTRY=k7q2-front-door gives /adminx/k7q2-front-door.
# Once set, /adminx is a plain 404 for everyone who isn't signed in as the admin.
ADMIN_ENTRY=

# Where the public Event Connect site lives (the admin links to its event pages and shows its event logos and photos).
EVENTS_ORIGIN=https://events.latars.xyz

# Support replies are emailed to the visitor who asked, if they left an address (https://resend.com).
RESEND_API_KEY=
ADS_MAIL_FROM=AdsSim <noreply@latars.xyz>
# Optional: official X API v2 bearer token, used when importing posts into an event's moments.
X_BEARER_TOKEN=
X_OEMBED_ENABLED=true
X_IMAGES_ENABLED=true

# Set to the same value as on the moonshot service if you use it there (it forces events live/before/after for testing).
# EVENT_MODE=

# Local work only: an embedded database with moonshot's tables (point at a checkout of moonshot's drizzle folder).
# MIGRATIONS_DIR=../moonshot/drizzle
